# CAVA payments — DEMO hasta secrets reales
VITE_PAYMENTS_MODE=demo
# demo | nowpayments | stripe_crypto

# Base URL del host que sirve /api/payments/* (vacío = same origin)
VITE_PAYMENTS_API_BASE=

# Solo señal client (opcional). Secrets REALES van en el server del host:
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_IPN_URL=https://tu-app/api/payments/usdt/ipn
# USDT_RECEIVE_ADDRESS=

# Stripe (opcional)
# STRIPE_SECRET_KEY=
# STRIPE_CRYPTO_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
